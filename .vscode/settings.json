{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "cmake.exportCompileCommandsFile": true,
  "cmake.buildBeforeRun": true,
  "terminal.integrated.defaultProfile.windows": "PowerShell UTF-8",
  "terminal.integrated.profiles.windows": {
    "PowerShell UTF-8": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "$utf8 = [System.Text.UTF8Encoding]::new($false); [Console]::InputEncoding = $utf8; [Console]::OutputEncoding = $utf8; $OutputEncoding = $utf8"
      ]
    }
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src",
    "${env:VCPKG_ROOT}/installed/x64-windows/include",
    "${env:VULKAN_SDK}/Include"
  ],
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerPath": "D:/VisualStudio/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}"
  },
  "glsllint.glslangValidatorArgs": [
    "-V",
    "--target-env",
    "vulkan1.3"
  ],
  "files.exclude": {
    "**/build": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.git/**": true,
    "**/*.spv": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/.git/**": true,
    "**/*.spv": true
  }
}
